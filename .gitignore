# ==============================================================================
# Power Volts - Comprehensive .gitignore for .NET Core Web API + React Ionic
# ==============================================================================

# --- .NET / C# Build Artifacts ---
bin/
obj/
*.user
*.userosscache
*.sln.docstates
*.suo
.vs/
.vscode/
_ReSharper*/
*.DotSettings.user

# --- SQLite Runtime Database Files ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Node.js / React / Ionic Frontend ---
node_modules/
dist/
build/
.vite/
.vite-temp/
.temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# --- Environment & Local Settings ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
appsettings.Development.json
appsettings.Local.json

# --- OS Specific Files ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
